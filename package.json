{
  "name": "reprise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "verify": "pnpm ultracite check && pnpm -r typecheck && pnpm -r test",
    "smoke:image": "bash infra/smoke-image.sh",
    "preflight:org": "bash infra/preflight-org.sh",
    "ultracite": "ultracite",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test:linux": "docker build -q -f infra/dev/linux-test.Dockerfile -t reprise-linux-test . && docker run --init --rm reprise-linux-test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.8",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9"
}
