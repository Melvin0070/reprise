{
  "name": "@reprise/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./limits": {
      "development": "./src/sandbox/limits.ts",
      "default": "./dist/sandbox/limits.js"
    },
    "./run": {
      "development": "./src/run/run-submission.ts",
      "default": "./dist/run/run-submission.js"
    },
    "./language": {
      "development": "./src/run/language.ts",
      "default": "./dist/run/language.js"
    },
    "./runner-config": {
      "development": "./src/run/runner-config.ts",
      "default": "./dist/run/runner-config.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@reprise/submission-state": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
